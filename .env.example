# ========================================
# AI 뉴스레터 환경 변수 설정
# 이 파일을 복사하여 .env 파일을 만드세요:
#   cp .env.example .env
# ========================================

# [필수] Anthropic API 키
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# [필수] Gmail 발신 계정
GMAIL_USER=your-email@gmail.com

# [필수] Gmail 앱 비밀번호
# 일반 Gmail 비밀번호가 아닌 앱 비밀번호를 사용해야 합니다.
# 발급 방법: Google 계정 > 보안 > 2단계 인증 활성화 후
#           Google 계정 > 보안 > 앱 비밀번호 > 앱 선택: 메일
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# [필수] 뉴스레터 수신 이메일
RECIPIENT_EMAIL=recipient@example.com

# [선택] 뉴스레터 이름 (기본값: Design Letter)
NEWSLETTER_NAME=Design Letter

# [선택] 에디터 이름 (기본값: 제시카AI)
AUTHOR_NAME=제시카AI
